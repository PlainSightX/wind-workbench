{"id":"fdfftr3tc2","doi":{"id":"10.17632/fdfftr3tc2.1","status":"allocated","prefix":"10.17632"},"name":"Renewable Energy and Electricity Demand Time Series Dataset with Exogenous Variables at 5-minute Interval","description":"The described database was created using data obtained from the California Independent System Operator (CAISO) and the National Renewable Energy Laboratory (NREL). All data was collected at five-minute intervals, and subsequently cleaned and modified to create a database comprising three time series: solar energy production, wind energy production, and electricity demand. The database contains 12 columns, including date, station (1: Winter, 2: Spring, 3: Summer, 4: Autumn), day of the week (0: Monday, ... , 6: Sunday), DHI (W/m2), DNI (W/m2), GHI (W/m2), wind speed (m/s), humidity (%), temperature (degrees), solar energy production (MW), wind energy production (MW), and electricity demand (MW).","version":1,"contributors":[{"institution":{"name":"Universidad Francisco de Paula Santander"},"profile_id":"964d5ac6-ba61-329b-9f89-f1d301e4e0f4","first_name":"Sebastian","last_name":"Rojas Ortega","orcid_id":"0009-0000-9620-2691"},{"institution":{"name":"Universidad Francisco de Paula Santander"},"profile_id":"49c83606-c3fd-4e20-bf94-2df74c1273c3","first_name":"Paola","last_name":"Castro-Correa","orcid_id":"0009-0006-8273-9782"},{"institution":{"name":"Universidad Francisco de Paula Santander"},"profile_id":"b83595a2-8e97-3d7e-b3c8-cf2ac8b293e7","first_name":"Sergio","last_name":"Sepúlveda-Mora","orcid_id":"0000-0002-1248-7616"},{"institution":{"name":"University of Delaware"},"first_name":"Jhon","last_name":"Castro-Correa","orcid_id":"0000-0002-2507-3535"}],"files":[{"filename":"Database.csv","id":"fff037a3-d0e4-496f-92f7-5c5820a734f1","content_details":{"id":"31cd9baa-ab24-4e1d-ae13-3a859bf0067a","sha256_hash":"d020a7352af89b72a9fd843ab9990e68db9333221c49b26925356c444465d7b0","content_type":"text/csv","size":29752780,"created_date":"2023-04-26T05:4